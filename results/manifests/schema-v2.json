{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instinct-bench/run-manifest/v2",
  "title": "Instinct Bench run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalizer",
    "derived_from",
    "run_id",
    "raw_job_path",
    "run_kind",
    "lifecycle",
    "publication",
    "benchmark",
    "runner",
    "agent_egress",
    "contract_visibility",
    "counts",
    "costs_usd",
    "trials"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "normalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_sha256"],
      "properties": {
        "name": {"const": "normalize_harbor_job_v2"},
        "version": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "derived_from": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_path", "schema_version", "sha256"],
          "properties": {
            "manifest_path": {"type": "string"},
            "schema_version": {"type": ["string", "null"]},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "run_id": {"type": "string", "minLength": 1},
    "harbor_job_uuid": {"type": ["string", "null"]},
    "raw_job_path": {"type": "string", "minLength": 1},
    "hub_url": {"type": ["string", "null"]},
    "run_kind": {
      "enum": ["preflight", "oracle-smoke", "model-canary", "model-pilot", "evaluation"]
    },
    "lifecycle": {
      "enum": ["planned", "running", "completed", "partial", "aborted", "cancelled"]
    },
    "publication": {
      "enum": ["scratch", "review", "eligible", "published", "superseded", "excluded"]
    },
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "status_reason": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "runner": {"$ref": "#/$defs/runner"},
    "agent_egress": {"enum": ["public", "allowlist", "no-network"]},
    "contract_visibility": {"enum": ["public", "private", "runtime-generated"]},
    "counts": {"$ref": "#/$defs/counts"},
    "costs_usd": {"$ref": "#/$defs/costs"},
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark": {
            "properties": {
              "implementation_version": {"pattern": "^0\\.3"}
            }
          },
          "run_kind": {"enum": ["oracle-smoke", "model-canary", "model-pilot", "evaluation"]}
        },
        "required": ["benchmark", "run_kind"]
      },
      "then": {
        "properties": {
          "benchmark": {
            "properties": {
              "release_metadata_digest": {"type": "string"},
              "release_name": {"type": "string"},
              "release_version": {"type": "string"},
              "split": {"type": "string"},
              "generator_version": {"type": "string"},
              "seed_commitment": {"type": "string"},
              "dataset_commitment": {"type": "string"},
              "package_set_commitment": {"type": "string"}
            }
          },
          "trials": {
            "items": {
              "properties": {
                "condition": {"enum": ["answer-now", "single-source", "complementary-evidence", "insufficient-evidence", "reliability-conflict"]},
                "scenario_block": {"type": "string", "minLength": 1},
                "instance_commitment": {"type": "string"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "implementation_version",
        "git_commit",
        "task_checksums",
        "release_metadata_digest",
        "release_name",
        "release_version",
        "split",
        "generator_version",
        "seed_commitment",
        "dataset_commitment",
        "package_set_commitment"
      ],
      "properties": {
        "name": {"const": "instinct-bench"},
        "domain": {"const": "context-appetite"},
        "implementation_version": {"type": "string"},
        "git_commit": {"type": "string"},
        "task_checksums": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "release_metadata_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_name": {"type": ["string", "null"]},
        "release_version": {"type": ["string", "null"]},
        "split": {"type": ["string", "null"]},
        "generator_version": {"type": ["string", "null"]},
        "seed_commitment": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dataset_commitment": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "package_set_commitment": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harbor_version",
        "agent",
        "harness_version",
        "skills",
        "prompt_digest",
        "environment",
        "sandbox_config",
        "provider",
        "provider_routing",
        "model",
        "effort",
        "temperature",
        "n_attempts",
        "n_concurrent",
        "command"
      ],
      "properties": {
        "harbor_version": {"type": "string"},
        "agent": {"type": "string"},
        "harness_version": {"type": ["string", "null"]},
        "skills": {"type": "array", "items": {"type": "string"}},
        "prompt_digest": {"type": ["string", "null"]},
        "environment": {"type": "string"},
        "sandbox_config": {"type": "object"},
        "provider": {"type": ["string", "null"]},
        "provider_routing": {"type": "object"},
        "model": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}},
            {"type": "null"}
          ]
        },
        "effort": {"type": ["string", "null"]},
        "temperature": {"type": ["number", "null"]},
        "n_attempts": {"type": "integer", "minimum": 1},
        "n_concurrent": {"type": "integer", "minimum": 1},
        "command": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "result_records",
        "completed",
        "benchmark_valid",
        "strict_pass",
        "domain_pass",
        "deadline",
        "infrastructure_error",
        "verifier_invalid",
        "verifier_error",
        "cancelled",
        "not_started",
        "verifier_evaluated",
        "recovered_strict_pass",
        "recovered_domain_pass",
        "answer_observed",
        "harness_confirmed"
      ],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "result_records": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "benchmark_valid": {"type": "integer", "minimum": 0},
        "strict_pass": {"type": "integer", "minimum": 0},
        "domain_pass": {"type": "integer", "minimum": 0},
        "deadline": {"type": "integer", "minimum": 0},
        "infrastructure_error": {"type": "integer", "minimum": 0},
        "verifier_invalid": {"type": "integer", "minimum": 0},
        "verifier_error": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0},
        "not_started": {"type": "integer", "minimum": 0},
        "verifier_evaluated": {"type": "integer", "minimum": 0},
        "recovered_strict_pass": {"type": "integer", "minimum": 0},
        "recovered_domain_pass": {"type": "integer", "minimum": 0},
        "answer_observed": {"type": "integer", "minimum": 0},
        "harness_confirmed": {"type": "integer", "minimum": 0}
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "harness", "sandbox", "total"],
      "properties": {
        "model": {"type": ["number", "null"], "minimum": 0},
        "harness": {"type": ["number", "null"], "minimum": 0},
        "sandbox": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "outcome": {"enum": ["pass", "fail", "not_evaluated"]},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "trial_name",
        "task_name",
        "condition",
        "scenario_block",
        "instance_commitment",
        "model",
        "attempt",
        "sampling_seed",
        "execution_status",
        "failure_stage",
        "failure_detail",
        "answer_observed",
        "verifier_status",
        "semantic_outcome",
        "proof_outcome",
        "format_outcome",
        "verifier_integrity",
        "harness_completion",
        "benchmark_valid",
        "strict_task_success",
        "domain_success",
        "diagnostics",
        "trajectory_path",
        "verifier_details_path",
        "evidence_state_path",
        "provider_route",
        "metrics",
        "telemetry",
        "costs_usd"
      ],
      "properties": {
        "trial_id": {"type": "string"},
        "trial_name": {"type": "string"},
        "task_name": {"type": "string"},
        "condition": {"type": ["string", "null"]},
        "scenario_block": {"type": ["string", "null"]},
        "instance_commitment": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model": {"type": ["string", "null"]},
        "attempt": {"type": "integer", "minimum": 1},
        "sampling_seed": {"type": ["integer", "string", "null"]},
        "execution_status": {
          "enum": ["completed", "deadline", "infrastructure_error", "cancelled", "not_started"]
        },
        "failure_stage": {
          "enum": ["provider_wait", "terminal_io", "agent_execution", "sandbox", "collection", "verifier", null]
        },
        "failure_detail": {"type": ["string", "null"]},
        "answer_observed": {"type": "boolean"},
        "verifier_status": {"enum": ["pass", "fail", "error", "not_run"]},
        "semantic_outcome": {"$ref": "#/$defs/outcome"},
        "proof_outcome": {"$ref": "#/$defs/outcome"},
        "format_outcome": {"$ref": "#/$defs/outcome"},
        "verifier_integrity": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "harness_completion": {"enum": ["confirmed", "unconfirmed", "not_evaluated"]},
        "benchmark_valid": {"type": "boolean"},
        "strict_task_success": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "domain_success": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recovered_strict_task_success",
            "recovered_domain_success",
            "semantic_resolution_method",
            "semantic_exact_disagreement",
            "agent_phase_returned"
          ],
          "properties": {
            "recovered_strict_task_success": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
            "recovered_domain_success": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
            "semantic_resolution_method": {
              "enum": ["none", "no_submission", "verifier_explicit", "exact_match", "canonicalized_unordered", "verifier_correctness"]
            },
            "semantic_exact_disagreement": {"type": "boolean"},
            "agent_phase_returned": {"type": "boolean"}
          }
        },
        "trajectory_path": {"type": ["string", "null"]},
        "verifier_details_path": {"type": ["string", "null"]},
        "evidence_state_path": {"type": ["string", "null"]},
        "provider_route": {"type": "object"},
        "metrics": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"]}
        },
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "costs_usd": {"$ref": "#/$defs/costs"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {"const": "completed"},
              "verifier_status": {"const": "pass"},
              "verifier_integrity": {"const": 1}
            },
            "required": ["execution_status", "verifier_status", "verifier_integrity"]
          },
          "then": {
            "properties": {
              "benchmark_valid": {"const": true},
              "strict_task_success": {"type": "integer"},
              "domain_success": {"type": "integer"}
            }
          }
        },
        {
          "if": {"properties": {"benchmark_valid": {"const": true}}, "required": ["benchmark_valid"]},
          "then": {
            "properties": {
              "execution_status": {"const": "completed"},
              "verifier_status": {"const": "pass"},
              "verifier_integrity": {"const": 1}
            }
          },
          "else": {
            "properties": {
              "strict_task_success": {"type": "null"},
              "domain_success": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"verifier_status": {"const": "pass"}}, "required": ["verifier_status"]},
          "then": {"properties": {"verifier_integrity": {"const": 1}}}
        },
        {
          "if": {"properties": {"verifier_status": {"const": "fail"}}, "required": ["verifier_status"]},
          "then": {"properties": {"verifier_integrity": {"const": 0}}}
        },
        {
          "if": {"properties": {"verifier_status": {"enum": ["error", "not_run"]}}, "required": ["verifier_status"]},
          "then": {"properties": {"verifier_integrity": {"type": "null"}}}
        },
        {
          "if": {"properties": {"verifier_status": {"enum": ["fail", "error", "not_run"]}}, "required": ["verifier_status"]},
          "then": {
            "properties": {
              "semantic_outcome": {"const": "not_evaluated"},
              "proof_outcome": {"const": "not_evaluated"},
              "format_outcome": {"const": "not_evaluated"},
              "diagnostics": {
                "properties": {
                  "recovered_strict_task_success": {"type": "null"},
                  "recovered_domain_success": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"answer_observed": {"const": false}}, "required": ["answer_observed"]},
          "then": {"properties": {"semantic_outcome": {"enum": ["fail", "not_evaluated"]}}}
        },
        {
          "if": {"properties": {"strict_task_success": {"const": 1}}, "required": ["strict_task_success"]},
          "then": {
            "properties": {
              "semantic_outcome": {"const": "pass"},
              "proof_outcome": {"const": "pass"},
              "format_outcome": {"const": "pass"}
            }
          }
        },
        {
          "if": {"properties": {"domain_success": {"const": 1}}, "required": ["domain_success"]},
          "then": {
            "properties": {
              "semantic_outcome": {"const": "pass"},
              "proof_outcome": {"const": "pass"}
            }
          }
        }
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_duration_seconds", "model_calls", "model_tokens", "evidence", "harness"],
      "properties": {
        "trial_duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment_setup_seconds",
            "agent_setup_seconds",
            "agent_execution_seconds",
            "post_agent_pre_verifier_seconds",
            "verifier_seconds",
            "whole_trial_seconds"
          ],
          "properties": {
            "environment_setup_seconds": {"type": ["number", "null"], "minimum": 0},
            "agent_setup_seconds": {"type": ["number", "null"], "minimum": 0},
            "agent_execution_seconds": {"type": ["number", "null"], "minimum": 0},
            "post_agent_pre_verifier_seconds": {"type": ["number", "null"], "minimum": 0},
            "verifier_seconds": {"type": ["number", "null"], "minimum": 0},
            "whole_trial_seconds": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "model_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "total_latency_ms", "mean_latency_ms", "max_latency_ms"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "total_latency_ms": {"type": ["number", "null"], "minimum": 0},
            "mean_latency_ms": {"type": ["number", "null"], "minimum": 0},
            "max_latency_ms": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "model_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cached_input", "total"],
          "properties": {
            "input": {"type": ["integer", "null"], "minimum": 0},
            "output": {"type": ["integer", "null"], "minimum": 0},
            "cached_input": {"type": ["integer", "null"], "minimum": 0},
            "total": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credits", "payload_bytes", "token_proxy", "source_sequence", "list_calls", "status_calls"],
          "properties": {
            "credits": {"type": ["integer", "number", "null"], "minimum": 0},
            "payload_bytes": {"type": ["integer", "number", "null"], "minimum": 0},
            "token_proxy": {"type": ["integer", "number", "null"], "minimum": 0},
            "source_sequence": {"type": "array", "items": {"type": "string"}},
            "list_calls": {"type": ["integer", "number", "null"], "minimum": 0},
            "status_calls": {"type": ["integer", "number", "null"], "minimum": 0}
          }
        },
        "harness": {"type": "object"}
      }
    }
  }
}
